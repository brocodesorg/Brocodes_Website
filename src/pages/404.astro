---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page Not Found">
  <div class="min-h-screen flex flex-col bg-[#FAF9F6] dark:bg-[#111113] text-[#1A1A1A] dark:text-[#F3F3F3]">
    <Header />

    <main class="flex-1 flex items-center justify-center px-4 py-20">
      <div class="text-center max-w-md mx-auto card-3d p-10 rounded-3xl bg-white/90 dark:bg-[#18181B]/90 backdrop-blur-md border border-[#EAE8E3] dark:border-[#27272A]">
        <div class="text-7xl font-black bg-gradient-to-r from-indigo-500 to-violet-500 bg-clip-text text-transparent mb-4">
          404
        </div>
        <h1 class="text-2xl font-bold text-gray-950 dark:text-white mb-2">Page Not Found</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-8 leading-relaxed">
          The page or project you are looking for doesn't exist or has been moved.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-sm rounded-xl shadow-md shadow-indigo-500/20 hover:shadow-lg transition-all"
        >
          <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Return to Projects
        </a>
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
