---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EmptyState from '../components/EmptyState.astro';
import ThreeCanvas from '../components/ThreeCanvas.astro';
import { siteConfig } from '../config/site';

// Import projects data generated at build time
import projectsData from '../data/projects.json';

const projects = projectsData;

// Extract unique categories and technologies for filters
const categories = [...new Set(projects.map(p => p.category))].filter(Boolean).sort();
const allTechnologies = [...new Set(projects.flatMap(p => p.technologies || []))].filter(Boolean).sort();
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <!-- Interactive 3D WebGL Constellation & Flux Field -->
  <ThreeCanvas />

  <div class="min-h-screen flex flex-col relative z-10">
    <Header />

    <main class="flex-1">
      <!-- 3D Hero Section -->
      <section class="relative pt-20 pb-16 sm:pt-28 sm:pb-24 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <!-- Structural Scaffold Grid Lines (ThreeUI-style) -->
        <div class="absolute inset-0 pointer-events-none flex justify-center -z-10 opacity-70">
          <div class="w-full max-w-7xl h-full grid grid-cols-1 md:grid-cols-4 border-x border-black/[0.04] dark:border-white/[0.05] relative">
            <div class="hidden md:block absolute top-[25%] -left-1 w-2 h-[1px] bg-indigo-500/40"></div>
            <div class="hidden md:block absolute top-[25%] -right-1 w-2 h-[1px] bg-indigo-500/40"></div>
            <div class="hidden md:block absolute bottom-[20%] -left-1 w-2 h-[1px] bg-indigo-500/40"></div>
            <div class="hidden md:block absolute bottom-[20%] -right-1 w-2 h-[1px] bg-indigo-500/40"></div>
          </div>
        </div>

        <div class="max-w-4xl mx-auto text-center relative z-10">
          <!-- Animated 3D Spinning Border Badge with Robot Mascot -->
          <div class="inline-block relative p-[1px] rounded-full overflow-hidden mb-8 shadow-[0_4px_24px_rgba(56,189,248,0.25)]">
            <div class="absolute inset-[-100%] bg-[conic-gradient(from_0deg,transparent_0_300deg,#06b6d4_330deg,#8b5cf6_360deg)] animate-beam-spin"></div>
            <div class="relative px-4 py-1.5 rounded-full bg-white/90 dark:bg-[#12131a]/90 backdrop-blur-xl flex items-center gap-2.5">
              <img src="/favicon.png" alt="BroCodes Mascot" class="w-5 h-5 rounded-full object-cover ring-1 ring-cyan-400/60 shadow-sm" />
              <span class="text-xs font-bold tracking-wider uppercase text-gray-800 dark:text-gray-200">
                BroCodes • 3D Creative Engineering
              </span>
            </div>
          </div>

          <!-- Futuristic Kinetic Headline -->
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-gray-950 dark:text-white mb-6 leading-[1.1]">
            Real Software. <br />
            <span class="text-shimmer">Built for the Future.</span>
          </h1>

          <p class="text-base sm:text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed font-normal">
            {siteConfig.hero.description}
          </p>

          <!-- 3D Feature Badges Row -->
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-gray-600 dark:text-gray-400">
            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/70 dark:bg-white/5 border border-black/[0.05] dark:border-white/10 backdrop-blur-md shadow-sm">
              <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              <span>1-Click Repo ZIP</span>
            </div>
            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/70 dark:bg-white/5 border border-black/[0.05] dark:border-white/10 backdrop-blur-md shadow-sm">
              <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              <span>Live Showcase Previews</span>
            </div>
            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/70 dark:bg-white/5 border border-black/[0.05] dark:border-white/10 backdrop-blur-md shadow-sm">
              <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              <span>Interactive 3D UI</span>
            </div>
          </div>

          <!-- Floating 3D Search & Filter Dock -->
          {projects.length > 0 && (
            <div class="mt-12 max-w-3xl mx-auto p-2.5 rounded-2xl bg-white/85 dark:bg-[#14151f]/85 backdrop-blur-xl border border-black/[0.06] dark:border-white/10 shadow-[0_16px_40px_-10px_rgba(0,0,0,0.12)] flex flex-col sm:flex-row gap-2 relative z-20">
              <div class="flex-1 relative">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>
                <input
                  type="text"
                  id="search"
                  placeholder="Search projects by keyword, tech, or feature..."
                  class="w-full pl-11 pr-4 py-3 rounded-xl bg-transparent text-sm text-gray-950 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
                />
              </div>

              {(categories.length > 0 || allTechnologies.length > 0) && (
                <div class="flex items-center gap-2 border-t sm:border-t-0 sm:border-l border-black/[0.06] dark:border-white/10 pt-2 sm:pt-0 sm:pl-3">
                  {categories.length > 0 && (
                    <select
                      id="category-filter"
                      class="px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-gray-50/80 dark:bg-white/5 border border-transparent hover:border-gray-200 dark:hover:border-white/10 text-gray-700 dark:text-gray-300 focus:outline-none cursor-pointer"
                    >
                      <option value="">All Categories</option>
                      {categories.map(cat => <option value={cat}>{cat}</option>)}
                    </select>
                  )}

                  {allTechnologies.length > 0 && (
                    <select
                      id="tech-filter"
                      class="px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-gray-50/80 dark:bg-white/5 border border-transparent hover:border-gray-200 dark:hover:border-white/10 text-gray-700 dark:text-gray-300 focus:outline-none cursor-pointer"
                    >
                      <option value="">All Tech</option>
                      {allTechnologies.map(tech => <option value={tech}>{tech}</option>)}
                    </select>
                  )}

                  <button
                    id="clear-filters"
                    class="px-3 py-2 text-xs font-semibold text-gray-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
                  >
                    Reset
                  </button>
                </div>
              )}
            </div>
          )}
        </div>
      </section>

      <!-- Projects Grid Section -->
      <section class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-20">
        {projects.length > 0 && (
          <div class="flex items-center justify-between mb-8">
            <div id="results-count" class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">
              Catalog • {projects.length} {projects.length === 1 ? 'Project' : 'Projects'}
            </div>
            <div class="text-[11px] font-mono text-gray-400">
              Interactive 3D View
            </div>
          </div>
        )}

        <div
          id="projects-grid"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
        >
          {projects.length === 0 ? (
            <div class="col-span-full">
              <EmptyState projects={projects} />
            </div>
          ) : (
            projects.map(project => (
              <ProjectCard project={project} />
            ))
          )}
        </div>

        <div id="no-results" class="hidden col-span-full text-center py-20">
          <p class="text-gray-500 dark:text-gray-400 text-sm">No matching projects found. Try a different search term or filter.</p>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<script define:vars={{ projects }}>
  function initFilterLogic() {
    const searchInput = document.getElementById('search');
    const categoryFilter = document.getElementById('category-filter');
    const techFilter = document.getElementById('tech-filter');
    const clearButton = document.getElementById('clear-filters');
    const resultsCount = document.getElementById('results-count');
    const projectsGrid = document.getElementById('projects-grid');
    const noResults = document.getElementById('no-results');

    if (!searchInput || !projectsGrid) return;

    function runFilter() {
      const q = searchInput.value.toLowerCase().trim();
      const cat = categoryFilter?.value || '';
      const tech = techFilter?.value || '';

      const cards = projectsGrid.querySelectorAll('.tilt-card-wrapper');
      let visible = 0;

      projects.forEach((p, idx) => {
        const card = cards[idx];
        if (!card) return;

        const matchQ = !q ||
          p.title.toLowerCase().includes(q) ||
          p.summary.toLowerCase().includes(q) ||
          (p.technologies && p.technologies.some(t => t.toLowerCase().includes(q)));

        const matchCat = !cat || p.category === cat;
        const matchTech = !tech || (p.technologies && p.technologies.includes(tech));

        if (matchQ && matchCat && matchTech) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (resultsCount) {
        resultsCount.textContent = `Catalog • ${visible} ${visible === 1 ? 'Project' : 'Projects'}`;
      }

      if (noResults) {
        if (visible === 0 && projects.length > 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', runFilter);
    categoryFilter?.addEventListener('change', runFilter);
    techFilter?.addEventListener('change', runFilter);
    clearButton?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (categoryFilter) categoryFilter.value = '';
      if (techFilter) techFilter.value = '';
      runFilter();
    });
  }

  initFilterLogic();
  document.addEventListener('astro:after-swap', initFilterLogic);
</script>
