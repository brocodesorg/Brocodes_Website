---
const { projects = [] } = Astro.props;
---

<div class="max-w-md mx-auto text-center py-16 px-6 card-3d rounded-3xl bg-white/90 dark:bg-[#18181B]/90 backdrop-blur-md border border-[#EAE8E3] dark:border-[#27272A] shadow-[0_12px_36px_-10px_rgba(0,0,0,0.06)]">
  <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-indigo-50 dark:bg-indigo-950/50 border border-indigo-100 dark:border-indigo-900/40 flex items-center justify-center text-indigo-600 dark:text-indigo-400 shadow-sm">
    <svg class="w-7 h-7 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
    </svg>
  </div>

  <h2 class="text-xl font-bold text-gray-950 dark:text-white mb-2">
    {projects.length === 0 ? "Project Library Ready" : "No Matching Projects"}
  </h2>

  <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xs mx-auto">
    {projects.length === 0
      ? "Your portfolio is ready. Whenever you tell me to add a project with its GitHub link, it will appear here."
      : "Try adjusting your search query or technology filters to find what you're looking for."}
  </p>
</div>
