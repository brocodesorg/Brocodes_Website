---
// ThreeCanvas.astro - 3D Interactive WebGL Background powered by Three.js
---

<div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden select-none" id="three-canvas-container" aria-hidden="true">
  <canvas id="three-webgl-canvas" class="w-full h-full block"></canvas>
  <!-- Ambient Gradient Glow Overlays for Extra 3D Depth matching Robot Logo palette -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1100px] h-[550px] bg-gradient-to-b from-cyan-500/10 via-purple-500/10 to-transparent blur-3xl pointer-events-none dark:from-cyan-500/15 dark:via-purple-600/15"></div>
  <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-gradient-to-t from-indigo-500/10 to-transparent blur-3xl pointer-events-none dark:from-cyan-900/15"></div>
</div>

<script>
  import * as THREE from 'three';

  function initThreeCanvas() {
    const canvas = document.getElementById('three-webgl-canvas') as HTMLCanvasElement;
    const container = document.getElementById('three-canvas-container');
    if (!canvas || !container) return;

    // Check prefers-reduced-motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 45;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    // 2. Determine Theme Palette
    function isDarkMode() {
      return document.documentElement.classList.contains('dark');
    }

    let particleOpacity = isDarkMode() ? 0.85 : 0.65;
    let lineOpacity = isDarkMode() ? 0.3 : 0.2;

    // 3. Multi-Color Particle Cloud (Cyan, Indigo, Purple, Chrome)
    const particleCount = window.innerWidth < 768 ? 85 : 155;
    const maxDistance = window.innerWidth < 768 ? 13 : 15;

    const positions = new Float32Array(particleCount * 3);
    const particleColors = new Float32Array(particleCount * 3);
    const velocities: { x: number; y: number; z: number }[] = [];

    const rangeX = 75;
    const rangeY = 48;
    const rangeZ = 32;

    // Palette inspired by the 3D robot & BroCodes sign
    const colorChoices = [
      new THREE.Color(0x38bdf8), // Cyan
      new THREE.Color(0x06b6d4), // Electric Teal
      new THREE.Color(0xa855f7), // Purple
      new THREE.Color(0xc084fc), // Bright Violet
      new THREE.Color(0x818cf8), // Indigo
      new THREE.Color(0xe0e7ff), // Chrome
    ];

    for (let i = 0; i < particleCount; i++) {
      const i3 = i * 3;
      positions[i3] = (Math.random() - 0.5) * rangeX;
      positions[i3 + 1] = (Math.random() - 0.5) * rangeY;
      positions[i3 + 2] = (Math.random() - 0.5) * rangeZ;

      const c = colorChoices[Math.floor(Math.random() * colorChoices.length)];
      particleColors[i3] = c.r;
      particleColors[i3 + 1] = c.g;
      particleColors[i3 + 2] = c.b;

      // Higher frequency velocity for livelier organic motion
      velocities.push({
        x: (Math.random() - 0.5) * 0.055,
        y: (Math.random() - 0.5) * 0.055,
        z: (Math.random() - 0.5) * 0.04
      });
    }

    const particlesGeometry = new THREE.BufferGeometry();
    particlesGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    particlesGeometry.setAttribute('color', new THREE.BufferAttribute(particleColors, 3));

    // Custom circle texture for soft glowing particles
    function createCircleTexture() {
      const size = 64;
      const c = document.createElement('canvas');
      c.width = size;
      c.height = size;
      const ctx = c.getContext('2d')!;
      const grad = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
      grad.addColorStop(0, 'rgba(255,255,255,1)');
      grad.addColorStop(0.35, 'rgba(255,255,255,0.85)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, size, size);
      const texture = new THREE.CanvasTexture(c);
      return texture;
    }

    const particleTexture = createCircleTexture();

    const particlesMaterial = new THREE.PointsMaterial({
      size: 1.8,
      vertexColors: true,
      map: particleTexture,
      transparent: true,
      opacity: particleOpacity,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });

    const particleSystem = new THREE.Points(particlesGeometry, particlesMaterial);
    scene.add(particleSystem);

    // 4. Line Mesh for Constellation Connections
    const maxLineConnections = (particleCount * (particleCount - 1)) / 2;
    const linePositions = new Float32Array(maxLineConnections * 6);
    const lineColors = new Float32Array(maxLineConnections * 6);

    const linesGeometry = new THREE.BufferGeometry();
    linesGeometry.setAttribute('position', new THREE.BufferAttribute(linePositions, 3).setUsage(THREE.DynamicDrawUsage));
    linesGeometry.setAttribute('color', new THREE.BufferAttribute(lineColors, 3).setUsage(THREE.DynamicDrawUsage));

    const linesMaterial = new THREE.LineBasicMaterial({
      vertexColors: true,
      transparent: true,
      opacity: lineOpacity,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });

    const linesMesh = new THREE.LineSegments(linesGeometry, linesMaterial);
    scene.add(linesMesh);

    // 5. Ambient Floating 3D Geometric Wireframes
    const geoGroup = new THREE.Group();
    const torusGeo = new THREE.IcosahedronGeometry(7.5, 1);
    const torusMat = new THREE.MeshBasicMaterial({
      color: isDarkMode() ? 0x38bdf8 : 0x0284c7,
      wireframe: true,
      transparent: true,
      opacity: isDarkMode() ? 0.18 : 0.08
    });
    const torusMesh = new THREE.Mesh(torusGeo, torusMat);
    torusMesh.position.set(25, 9, -10);
    geoGroup.add(torusMesh);

    const torus2Geo = new THREE.TorusGeometry(5.5, 1.2, 12, 36);
    const torus2Mat = new THREE.MeshBasicMaterial({
      color: isDarkMode() ? 0xa855f7 : 0x7c3aed,
      wireframe: true,
      transparent: true,
      opacity: isDarkMode() ? 0.15 : 0.07
    });
    const torus2Mesh = new THREE.Mesh(torus2Geo, torus2Mat);
    torus2Mesh.position.set(-27, -11, -15);
    geoGroup.add(torus2Mesh);

    scene.add(geoGroup);

    // 6. Mouse Interaction & Parallax
    let mouseX = 0;
    let mouseY = 0;
    let targetCameraX = 0;
    let targetCameraY = 0;

    function onMouseMove(e: MouseEvent) {
      const normX = (e.clientX / window.innerWidth) * 2 - 1;
      const normY = -(e.clientY / window.innerHeight) * 2 + 1;
      mouseX = normX;
      mouseY = normY;
      targetCameraX = normX * 4.5;
      targetCameraY = normY * 3.5;
    }

    window.addEventListener('mousemove', onMouseMove, { passive: true });

    // 7. Scroll Interaction
    let scrollY = 0;
    function onScroll() {
      scrollY = window.scrollY || document.documentElement.scrollTop;
    }
    window.addEventListener('scroll', onScroll, { passive: true });

    // 8. Theme Change Watcher
    const observer = new MutationObserver(() => {
      const dark = isDarkMode();
      particleOpacity = dark ? 0.85 : 0.65;
      lineOpacity = dark ? 0.3 : 0.2;

      particlesMaterial.opacity = particleOpacity;
      linesMaterial.opacity = lineOpacity;
      torusMat.color.setHex(dark ? 0x38bdf8 : 0x0284c7);
      torusMat.opacity = dark ? 0.18 : 0.08;
      torus2Mat.color.setHex(dark ? 0xa855f7 : 0x7c3aed);
      torus2Mat.opacity = dark ? 0.15 : 0.07;
    });

    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // 9. Resize Handler
    function onResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    }
    window.addEventListener('resize', onResize);

    // 10. Animation Loop
    let animationFrameId: number;
    let isVisible = true;

    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
    });

    const clock = new THREE.Clock();

    function animate() {
      animationFrameId = requestAnimationFrame(animate);

      if (!isVisible) return;

      const elapsed = clock.getElapsedTime();

      // Smooth camera interpolation
      camera.position.x += (targetCameraX - camera.position.x) * 0.035;
      camera.position.y += (targetCameraY - camera.position.y - (scrollY * 0.015)) * 0.035;
      camera.lookAt(0, -scrollY * 0.015, 0);

      // Rotate geometric wireframes
      torusMesh.rotation.x = elapsed * 0.22;
      torusMesh.rotation.y = elapsed * 0.28;
      torus2Mesh.rotation.x = -elapsed * 0.18;
      torus2Mesh.rotation.z = elapsed * 0.16;

      // Update particle positions and velocities
      const posArray = particlesGeometry.attributes.position.array as Float32Array;
      const partColArray = particlesGeometry.attributes.color.array as Float32Array;
      const linePosArray = linesGeometry.attributes.position.array as Float32Array;
      const lineColArray = linesGeometry.attributes.color.array as Float32Array;

      let vertexIndex = 0;
      let colorIndex = 0;

      for (let i = 0; i < particleCount; i++) {
        const i3 = i * 3;

        // Apply velocity
        posArray[i3] += velocities[i].x;
        posArray[i3 + 1] += velocities[i].y;
        posArray[i3 + 2] += velocities[i].z;

        // Boundary bounce
        if (Math.abs(posArray[i3]) > rangeX / 2) velocities[i].x *= -1;
        if (Math.abs(posArray[i3 + 1]) > rangeY / 2) velocities[i].y *= -1;
        if (Math.abs(posArray[i3 + 2]) > rangeZ / 2) velocities[i].z *= -1;

        // Inter-particle line connections with blended colors
        for (let j = i + 1; j < particleCount; j++) {
          const j3 = j * 3;
          const dx = posArray[i3] - posArray[j3];
          const dy = posArray[i3 + 1] - posArray[j3 + 1];
          const dz = posArray[i3 + 2] - posArray[j3 + 2];
          const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

          if (dist < maxDistance) {
            const alpha = 1.0 - dist / maxDistance;

            linePosArray[vertexIndex++] = posArray[i3];
            linePosArray[vertexIndex++] = posArray[i3 + 1];
            linePosArray[vertexIndex++] = posArray[i3 + 2];

            linePosArray[vertexIndex++] = posArray[j3];
            linePosArray[vertexIndex++] = posArray[j3 + 1];
            linePosArray[vertexIndex++] = posArray[j3 + 2];

            // Blend colors of particle i and particle j
            lineColArray[colorIndex++] = partColArray[i3] * alpha;
            lineColArray[colorIndex++] = partColArray[i3 + 1] * alpha;
            lineColArray[colorIndex++] = partColArray[i3 + 2] * alpha;

            lineColArray[colorIndex++] = partColArray[j3] * alpha;
            lineColArray[colorIndex++] = partColArray[j3 + 1] * alpha;
            lineColArray[colorIndex++] = partColArray[j3 + 2] * alpha;
          }
        }
      }

      particlesGeometry.attributes.position.needsUpdate = true;
      linesGeometry.attributes.position.needsUpdate = true;
      linesGeometry.attributes.color.needsUpdate = true;
      linesGeometry.setDrawRange(0, vertexIndex / 3);

      renderer.render(scene, camera);
    }

    animate();

    // Cleanup on view transitions
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationFrameId);
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      observer.disconnect();
      renderer.dispose();
    }, { once: true });
  }

  // Initialize
  initThreeCanvas();
  document.addEventListener('astro:after-swap', initThreeCanvas);
</script>
